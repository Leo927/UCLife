// Issue #64 smoke fixture — MS-parts acquisition (broker + combat loot).
//
// Player aboard the flagship at Von Braun with cash + piloting skill so the
// boardShip + startCombat cheats unlock. The starter MS (ms-player-0) +
// PlayerPartsInventory are granted at boot (grantStarterMsToFlagship), so
// the smoke can buy parts at the AE dealer, salvage parts from a broken-down
// pirate_raider, and install the acquired weapon on the starter MS.
//
// Same baseline shape as ms-sortie, minus the recovery-tug captain (this
// smoke never strands an MS).
//
// W1 Task 5 — the starter MS + parts inventory are no longer boot-granted;
// this fixture pins them (a `gm_pre`, as before). buyPartCheat needs the
// PlayerPartsInventory singleton to exist, and the install step needs the MS.
{
  seed: 'ms-parts-001',
  startDate: '2026-05-27T08:00:00Z',
  scene: 'playerShipInterior',

  player: {
    money: 200000,
    location: { scene: 'playerShipInterior', x: 5, y: 5 },
    skills: { piloting: 5000 },
  },

  ships: [
    { id: 'ship', template: 'lightFreighter', name: '自由号', dockedAt: 'vonBraun', flagship: true },
  ],

  ms: [
    { key: 'ms-player-0', template: 'gm_pre', storedOnShip: 'ship', bayIndex: 0 },
  ],

  parts: {
    weapons: { 'ms-ballisticGun': 1, 'ms-missileRack': 1 },
    frameMods: {
      extPropellantTank: 1,
      autoloader: 1,
      lifeSupportPod: 1,
      armorPlating: 1,
      subThruster: 1,
    },
  },
}
