// Phase 6.3.B — colony economics configuration.
// Colony-level income + stability weight, resupply markup, and recruitment
// discount constants. All per-facility-type income rates are keyed by the
// Building typeId (matches building-types.json5 keys).
{
  income: {
    // Credits added to the player faction fund per owned facility type per day.
    // Only applies when the colony POI is in the player-colony registry.
    perFacilityType: {
      colonyRefineryShell: 500,
      colonyRefinery: 800,
      colonyHydroponics: 300,
      colonyMiningDrill: 600,
    },
    // Daily supply/fuel deposited into a colony's Hangar reserve (if present).
    // Applied by colonyEconomicsSystem on day:rollover so the colony stockpile
    // slowly fills without the player placing AE dealer orders.
    hangarResupplyPerDay: {
      supply: 50,
      fuel: 20,
    },
  },

  stability: {
    // Base score before facility contributions. Colonies start neutral.
    baseScore: 0,
    // Per-day contribution for each QoL facility type present.
    qolContribution: {
      bar: 10,
      clinic: 10,
    },
    // Per-day penalty applied once for each QoL type that is absent.
    // A colony with no bar and no clinic loses 2 × missingQolPenaltyPerType per day.
    missingQolPenaltyPerType: -15,
  },

  recruitment: {
    // Fraction of signingBonus charged when hiring an NPC from a player colony.
    // 0.5 means pay half the normal signing fee.
    colonySigningFeeDiscount: 0.5,
    // Opinion added to the NPC→player Knows edge on successful colony hire.
    colonyLoyaltyBonus: 20,
  },

  resupply: {
    // Credit multiplier for colony depot supply/fuel transfers to player ships.
    // 0.0 = free (player's own stock; no markup charged).
    markupFactor: 0.0,
  },

  // Phase 6.3.C — build-path charter configuration.
  // Permits officials at EFSF / Zeon / AE major POIs grant charters.
  // repGate is the minimum faction-rep score required for approval.
  charter: {
    feeBase: 50000,
    repGate: 30,
    factions: ['efsf', 'zeon', 'anaheim'],
  },

  // Phase 6.3.C — per-facility-type construction duration (game-days).
  // Interrupts fire at interruptChancePerJobPerDay probability per in-progress
  // job per day:rollover tick, using the seeded sim RNG for determinism.
  construction: {
    durationDays: {
      colonyHabPod: 1,
      colonyRefinery: 7,
      colonyHydroponics: 5,
      colonyHabitation: 3,
      colonyMSFactory: 14,
      colonyWarshipSlipway: 21,
      colonyBarracks: 5,
      colonyMiningDrill: 7,
      colonyBar: 3,
      colonyMarket: 3,
      colonyClinic: 4,
    },
    interruptChancePerJobPerDay: 0.1,
  },

  // Phase 6.3.C — establishment package fleet cargo item.
  // One purchase at a major shipyard covers the hab pod, construction crew,
  // and initial supplies for a single new colony.
  establishmentPackage: {
    cost: 200000,
    cargoId: 'colony-establishment-package',
  },

  // Phase 6.3.D — administrative-load gate.
  // Player Leadership is the primary contributor to how many colonies can be
  // administered simultaneously. Leadership is deferred in the skill catalog;
  // this section reads an existing shipped skill as a stand-in (keyed here so
  // the swap to real Leadership is config-only when it ships).
  //
  // Formula:
  //   adminCapacity = loadCapBase + floor(player_skill_level * loadCapPerSkillLevel)
  //   personalLoad  = sum per colony: loadPerColony * (1 − adminLoadReductionFraction if admin assigned, else 1)
  //   overload      = max(0, personalLoad − adminCapacity)
  //
  // Per-day stability penalty for each player-administered colony (one without
  // an assigned administrator) when the player is over capacity:
  //   penalty = overload * overloadStabilityPenaltyPerPoint
  adminLoad: {
    // SKILL STAND-IN (Issue #81): Leadership earns an id only when a trainer
    // verb AND a consumer system ship together. `engineering` is the closest
    // existing shipped skill; swap is config-only when Leadership ships.
    leadershipSkillStandin: 'engineering',
    // Base admin capacity (colonies manageable with no skill investment).
    loadCapBase: 1,
    // Additional capacity per skill LEVEL (0–100).
    // Level 25 → +1; level 50 → +2; level 100 → +4.
    loadCapPerSkillLevel: 0.04,
    // Admin-load cost per colony the player personally administers.
    loadPerColony: 1,
    // Fraction of load handled by an assigned administrator.
    // 0.6 means the admin carries 60% of the colony's load; player pays 40%.
    adminLoadReductionFraction: 0.6,
    // Stability-score penalty applied per unit of overload per day,
    // to each colony without an assigned administrator.
    overloadStabilityPenaltyPerPoint: -10,
  },

  // Phase 6.3.D — colony detention.
  // Default capacity for surplus prisoners routed from the flagship brig.
  // A future facility type (colonyDetentionBlock) will raise this.
  detention: {
    defaultDetentionCapacity: 4,
  },

  // Phase 6.3.E — colony threat configuration.
  // Raid chance formula per day:
  //   chance = clamp(0, maxRaidChancePerDay,
  //              baseRaidChancePerDay
  //              + raidWealthFactor * dailyIncome
  //              - raidGarrisonFactor * garrisonStrength)
  //   If pirateAttentionFlag is set: chance *= pirateAttentionMultiplier.
  //
  // Garrison strength formula:
  //   strength = barracksCount * garrisonStrengthPerBarracks
  //              + commanderLevel * garrisonStrengthPerCommanderSkillLevel
  //
  // Stability collapse: when stabilityScore drops below stabilityFloor for
  // collapseGraceDays consecutive days the player loses colony ownership.
  threats: {
    // Per-day base probability of a pirate raid when garrison = 0, income = 0.
    baseRaidChancePerDay: 0.05,
    // Additional raid chance per credit of daily colony income.
    raidWealthFactor: 0.00005,
    // Raid-chance reduction per unit of garrison strength.
    raidGarrisonFactor: 0.01,
    // Maximum raid chance per day regardless of wealth / garrison.
    maxRaidChancePerDay: 0.4,
    // Multiplier applied to raid chance when the colony has pirateAttentionFlag.
    pirateAttentionMultiplier: 2.0,
    // Garrison strength contributed per colonyBarracks building present.
    garrisonStrengthPerBarracks: 3,
    // Stand-in skill id for garrison commander effectiveness (swap to Tactics
    // when it ships — config-only change, same pattern as adminLoad.leadershipSkillStandin).
    garrisonCommanderSkillStandin: 'piloting',
    // Garrison strength per skill LEVEL of the assigned garrison commander.
    garrisonStrengthPerCommanderSkillLevel: 0.5,
    // Minimum garrison strength for the garrison to auto-resolve a raid without
    // player involvement.
    autoResolveGarrisonThreshold: 5,
    // Threat level of a standard pirate raid (compared to garrison strength for
    // auto-resolve; determines encounter difficulty if the player must defend).
    raidThreatLevel: 4,
    // Minimum game-days between raid attempts on the same colony.
    raidCooldownDays: 7,
    // Stability score at which the colony enters the collapse grace period.
    stabilityFloor: -30,
    // Number of consecutive days below the stability floor before ownership is lost.
    collapseGraceDays: 3,
  },
}
