// Space-scene tunables. Speeds, drain rates, snap radii — everything that
// the engine layer (src/engine/space/) and the campaign systems
// (src/systems/space.ts, src/sim/space*.ts) read. Edit + refresh; no
// hot-reload (per CLAUDE.md, json5 configs are parsed once at module load).
{
  // Global multiplier on max ship speed. 1 = baseShipMaxSpeed exactly;
  // raise for tuning sessions, lower if combat feels twitchy.
  shipSpeedScale: 1,

  // Hard speed ceiling for a ship at thrust scale 1, in world px / sec.
  baseShipMaxSpeed: 220,

  // Acceleration per Thrust unit in world px/sec². At thrust=1 the ship
  // spins up from 0 to baseShipMaxSpeed in ~2.75 sec.
  thrustAccel: 80,

  // Fuel consumed per second of full-thrust acceleration. Charged on
  // actual post-clamp delta-v — cruising at maxSpeed costs nothing,
  // only real velocity changes (spin-up, braking, turning) burn fuel.
  fuelPerThrustSec: 0.4,

  // Continuous supply drain — life support, paid every game-hour
  // regardless of activity.
  supplyDrainPerHour: 1.0,

  // Per-MS-aboard maintenance load drained per game-hour. Larger fleets
  // eat more even at rest.
  perMaintenanceLoadDrainPerHour: 0.5,

  // Per-real-second supply cost while active combat repair runs (the
  // auto-fix-hull tick on the ship sheet).
  combatRepairDrainPerSec: 0.2,

  // Multiplier on orbit angular velocity. 1 = canonical period in
  // game-days exactly (Moon completes one revolution in 27.3 game-days).
  // Bump for visible drift in short test sessions.
  orbitTimeScale: 1,

  // Distance at which a ship enters an enemy's aggro check, in world px.
  // Enemies whose own aggroRadius overlaps fire the engagement modal.
  // W1 Task 7 — 24px demanded near-exact convergence with a moving
  // target (autopilot arrival tolerance is only 4px), so an intercept
  // course spent most of its fuel budget on fine velocity-matching
  // maneuvers chasing a patrol's live position. 96px lets contact fire
  // once the ship is meaningfully alongside the target, matching the
  // scale of enemyPickRadius (the UI's own "close enough" tolerance for
  // targeting the same ships).
  aggroContactRadius: 96,

  // Padding on each edge when M fits the whole sector to viewport.
  fitSystemPaddingPx: 200,

  // Click-target snap radius, in world px. Clicking within this distance
  // of a POI's derived position targets the POI specifically; outside
  // this, clicks resolve to free-space coordinates.
  dockSnapRadius: 80,

  // Click-target snap radius for enemy ships, in world px. Same role as
  // dockSnapRadius but for the Intercept context-menu action — enemy
  // sprites don't have a fixed dock marker, so this owns its own tunable
  // rather than reusing dockSnapRadius by coincidence.
  // W1 Task 7 — sanity-checked against the aggroContactRadius bump
  // (24 -> 96): 80 stays as-authored. It's a click-hit-test tolerance
  // (player intent), not a sim trigger radius, so it doesn't need to
  // track aggroContactRadius 1:1 — but the two should stay the same
  // order of magnitude so "click to target" and "close enough to fight"
  // read as the same distance to the player, and 80 vs 96 already does.
  enemyPickRadius: 80,

  // Autopilot arrival tolerance, in world px. The ship declares the
  // course complete once it is within this distance and below
  // arrivalSpeed. Keep small so free-space "go here" clicks land at the
  // actual cursor — POI auto-dock courses still snap Position to the live
  // POI on arrival, so this doesn't affect docking accuracy.
  autopilotArriveRadiusPx: 4,

  // W1 Task 7 — enemyAI.ts tunables, formerly module-level constants.
  // Moved here so they're editable without a code change.
  enemyAi: {
    // Waypoint-reached tolerance for a patrolling enemy advancing along
    // its authored patrolPath, in world px.
    patrolWaypointRadiusPx: 40,
    // Multiplier on aggroRadius an enemy must exit before a chase reverts
    // to patrol — keeps a chasing enemy from flickering in and out of
    // chase mode right at the aggro boundary.
    chaseHysteresis: 1.5,
    // Fraction of baseShipMaxSpeed an enemy hull tops out at, relative to
    // the player's own max speed.
    speedFactor: 0.85,
  },

  // Dashed line between elevator-linked POIs on the starmap. Lengths are
  // in *world* px and the renderer divides by camera scale so the dashes
  // stay a constant *screen* size at any zoom. Subtle grey + 50% alpha so
  // the line reads as transit infrastructure, not a navigation course.
  liftLine: {
    dashWorldPx: 4,
    gapWorldPx: 4,
    strokeWorldPx: 1,
    colorHex: '0x94a3b8',
    alpha: 0.5,
  },
}
