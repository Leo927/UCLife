// Phase 6.0 tactical-combat tunables. Read by src/systems/combat.ts,
// src/systems/combatLog.ts, and src/ui/TacticalView.tsx.
{
  // Combat event log — Starsector-shape top-left fading scroll.
  // logMaxEntries bounds memory; visible-window/fade durations gate
  // how long an entry stays on-screen before fading and being purged
  // from the active scroll (it lingers in the Tab-toggled full history
  // until cleared at the next engagement).
  logMaxEntries: 30,
  // Entries stay fully visible for this many real-seconds.
  logVisibleSec: 8,
  // After the visible window, the entry fades to alpha 0 over this many
  // real-seconds, then drops out of the live scroll.
  logFadeSec: 1.2,

  // Narrowed tactical auto-pause set (Phase 6.0): first-contact +
  // flagship hull crosses these thresholds. Boarders + player-piloted
  // MS at hull 0 land in 6.1; for now the 25 / 10 percentile thresholds
  // are the entire set beyond first contact.
  flagshipPauseHullPcts: [0.25, 0.1],

  // W3 (ms-identity) Task 3 — projectile/beam collision radius (arena
  // units) for any CombatShipState row that doesn't author its own
  // hitRadiusPx: the flagship, active-fleet ship escorts, and non-isMs
  // enemyShips.json5 rows. This is the pre-existing hardcoded value
  // tickProjectiles used before hitRadiusPx was threaded per-row — kept
  // identical here so ship-vs-ship combat is unchanged; MS rows author a
  // smaller hitRadiusPx on their own ms-classes.json5 / enemyShips.json5
  // row so they're genuinely harder to hit.
  defaultShipHitRadiusPx: 12,

  // Post-combat tally — minimum payout shape for Phase 6.0.
  // Reward magnitudes for victory:
  //   creditsMin / creditsMax — fiat reward range per engagement.
  //   suppliesGain / fuelGain — flat material recovery on victory.
  tallyCreditsMin: 800,
  tallyCreditsMax: 1500,
  tallySuppliesGain: 6,
  tallyFuelGain: 2,

  // W2 command layer — an escort under a standing rally order steers toward
  // the rally point until within this many arena units, then resumes normal
  // maintainRange movement (close/back/strafe against its resolved
  // hostile). Small relative to the arena (1000x600) and to ship
  // maintainRange values (160-320) so "arrived" reads as "holding station
  // near the point," not "still crossing the arena."
  rallyArriveRadiusPx: 40,

  // W2 Task 2 — click-target mode for the order palette's focus-fire order.
  // The player clicks a point in the arena (not the enemy sprite directly —
  // hulls are small and the arena scales with viewport size); the nearest
  // enemy snapshot within this many arena units of the click resolves as
  // the target. No enemy within range cancels the order. Small enough that
  // clicking near one enemy in a cluster doesn't accidentally pick its
  // neighbor, generous enough to tolerate imprecise clicking at a
  // letterboxed, possibly-scaled-down arena.
  orderPickRadiusPx: 60,

  // W2 Task 3 — mid-combat withdraw + the pre-combat engagement modal's
  // flee choice share one penalty + debrief path (resolveFleeWithDebrief()
  // in combat.ts).
  // Starsector "you can't run for free" feel: hull takes the bigger hit,
  // armor depletes fully (it regenerates between encounters anyway), CR
  // drains heavily so back-to-back flees stack up a real cost.
  fleePenalty: {
    hullLossPct: 0.35,
    crDrain: 50,
  },

  // Defeat: the flagship is destroyed and the survivor is stripped to this
  // rescue stipend. Other progression (skills, perks, relationships,
  // ambitions) survives — the run continues from a ground colony.
  defeat: {
    survivorMoney: 200,
  },

  // W2 Task 3 — withdraw is a one-shot, CP-free, always-available verb, so a
  // misclick shouldn't be able to pay its hull/CR cost by accident. First
  // click on 撤退 arms a confirm state; a second click on the same button
  // within this window commits. Long enough for a deliberate follow-up
  // click, short enough that walking away and coming back later doesn't
  // leave a stale "confirm?" button armed.
  withdrawConfirmWindowMs: 3000,

  // W4 Task 7 — negotiate = clean peaceful disengage on a paid toll (no
  // fight, no flee penalty). The hostile lead demands a base bribe plus a
  // per-escort surcharge for every wingman it has to call off:
  //   toll = tollBase + tollPerEscort × escortCount.
  // tollBase (300) is well under the low-end victory payout (tallyCreditsMin
  // 800) so buying out of a lone pirate is cheaper than fighting but never
  // free; tollPerEscort (150) makes talking down a full wing cost real money,
  // keeping negotiate a deliberate spend rather than a no-brainer.
  negotiate: {
    tollBase: 300,
    tollPerEscort: 150,
  },

  // W3 (ms-identity) Task 4 — hostile-MS pilot AI knobs (reaction delay +
  // aim jitter live entirely in each enemyShips.json5 row's `pilot` block;
  // this is the one knob shared across every enemy-MS pilot).
  pilotAi: {
    // How often (in-tactical seconds) an enemy-MS pilot re-rolls whether to
    // trigger its vernier boost while closing or disengaging (rolled against
    // pilot.boostUse). A decision WINDOW, not a per-tick coinflip — rolling
    // every tick would make boostUse behave like "fraction of time spent
    // boosting" instead of "probability of choosing to boost this pass."
    boostDecisionWindowSec: 1.0,
  },

  // W4.6 (presentation floor) — tactical arena backdrop starfield. Built
  // ONCE in the PixiTacticalRenderer constructor and never touched again
  // (perf rule: no per-frame star work). Seeded so the pattern is stable
  // across sessions and reproducible in review. Placement is uniform over
  // the fixed 1000×600 arena; density (count) is tuned to read as a sparse
  // deep-space field, not a busy nebula. Radii/alpha in arena units.
  tacticalStarfield: {
    count: 90,
    seed: 60077,          // UC 0077 flavor seed; any fixed integer is fine.
    minRadiusPx: 0.4,
    maxRadiusPx: 1.4,
    minAlpha: 0.12,
    maxAlpha: 0.55,
    colorHex: '0x9aa7c7',
  },

  // W4.6 — per-class ship silhouettes for the tactical arena. Each family's
  // `poly` is a FLAT [x0,y0,x1,y1,…] polygon normalized to hullRadius units,
  // authored nose-first (+x = forward heading). drawShip() scales every
  // point by snap.hullRadius and rotates the Graphics by heading, so the
  // same shape works at any hull size. Families keep classes visually
  // distinct (freighter blocky, frigate dart, capital spear, ms compact
  // chevron); `byClassId` routes each class id to a family and any unmapped
  // id (procedural/new hulls) falls back to `fallback`.
  shipSilhouettes: {
    fallback: 'arrowhead',
    byClassId: {
      lightFreighter: 'freighter',
      lunarMilitia: 'frigate',
      pegasusClass: 'capital',
      pirateLight: 'frigate',
      pirate_skirmisher: 'frigate',
      pirate_raider: 'freighter',
      gm_pre: 'ms',
      civFighter: 'ms',
      mobileWorker: 'ms',
      pirate_junkerMs: 'ms',
      pirate_junkerMs_gun: 'ms',
    },
    families: {
      // The pre-W4.6 shape, kept as the universal fallback.
      arrowhead: { poly: [1, 0, -0.7, 0.6, -0.4, 0, -0.7, -0.6] },
      // Blunt-nosed boxy hauler.
      freighter: { poly: [0.9, 0.45, 1, 0, 0.9, -0.45, -0.95, -0.5, -1.05, 0, -0.95, 0.5] },
      // Sleek escort dart — longer nose, tight tail notch.
      frigate: { poly: [1.25, 0, -0.55, 0.5, -0.3, 0, -0.55, -0.5] },
      // Elongated capital spear with a broad aft.
      capital: { poly: [1.4, 0, 0.4, 0.32, -1, 0.5, -1.15, 0, -1, -0.5, 0.4, -0.32] },
      // Compact wide-winged chevron — reads as a fast small unit.
      ms: { poly: [1, 0, -0.4, 0.75, -0.15, 0, -0.4, -0.75] },
    },
  },
}
