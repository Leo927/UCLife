{
  // Skill Perks — Design/characters/skills.md § Skill Perks (issue #142).
  // At each tier level the player picks one of N mutually-exclusive
  // options per skill, free (no AP). Authoring contract: every tier must
  // offer ≥2 options and ≥1 option carrying `unlocks` or `abilities` —
  // enforced by a data-validation unit test (skillPerks.test.ts).
  //
  // `unlocks` flags are forward contracts: consumers (recipe registry,
  // verb menus, dialogue gates) read them via hasUnlock() as they ship.
  // `abilities` rows are reserved data (no consumer until the
  // active-abilities subsystem lands with combat).

  // Milestone levels, ascending. Level 90 is reserved (not authored).
  tiers: [30, 60],

  // Respec at a staffed Tutor seat. money = moneyBase × moneyGrowth^n,
  // days = daysBase + daysPerRespec × n, where n = the player's prior
  // respec count. First reroll is forgiving; compulsive rerolling stings.
  respec: {
    moneyBase: 500,
    moneyGrowth: 2,
    daysBase: 2,
    daysPerRespec: 1,
  },

  catalog: {
    cooking: {
      '30': [
        {
          id: 'meal_prep',
          nameZh: '备餐高手',
          descZh: '一次烹饪动作产出两份饭菜。',
          unlocks: ['cook:double_batch'],
        },
        {
          id: 'gourmand',
          nameZh: '美食家',
          descZh: '可以从普通食材做出高级套餐。',
