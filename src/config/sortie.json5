// Phase 6.2.5.C — tactical-time sortie tunables. Read by the resupply +
// drain + door + recovery-tug systems and the cockpit launch/dock path.
//
// Replaces the 6.1 single-placeholder-door fields on `cockpit.json5`
// (`launchOffset` / `launchVelocity` — deleted) once per-ship-class
// `hangarDoors[]` authoring is wired through. `dockApproachRadiusPx`
// / `dockApproachMaxRelVel` move here too because docking is a sortie
// concept, not a cockpit-loop concept.
{
  // ── Mid-combat resupply formula (Design/sortie.md) ────────────────────
  // resupplyTime = baseResupplySec
  //                  / hangarBoss.workPerformance
  //                  / (1 + Σ mechanicCrewEfficiency at this bay)
  //                  / resourceBoostMul
  baseResupplySec: 15,
  // Per-crew additive efficiency contribution. 2 on-duty mechanic-crew
  // slots × 0.5 = +1.0, so baseline two-crew bay halves the resupply
  // window relative to a zero-crew bay (which still completes at the
  // boss-modified rate because the formula's `1 +` baseline guarantees
  // it). Tunable as one knob.
  mechanicCrewEfficiencyPerSlot: 0.5,
  // Placeholder when no hangar boss is assigned — pre-Phase-6.2.5.D the
  // ship's hangar-boss slot isn't authored, so resupply uses 1.0 to keep
  // the math sensible until the captain's-office crew-roster lands.
  defaultHangarBossPerformance: 1,
  // Placeholder when no on-duty mechanic crew is authored on the ship
  // yet. Pre-Phase-6.2.5.D the comm panel doesn't surface mechanic-crew
  // assignment, so the formula uses this count.
  defaultMechanicCrewCount: 0,

  // ── Door cycle timings (Design/sortie.md §Hangar door / launch pos) ──
  // A door cycles `idle → launching → idle → docking → idle` and locks
  // for these many tactical-seconds per operation. ~2s in design.
  launchDoorLockSec: 2,
  dockDoorLockSec: 2,

  // ── Dock approach (re-homed from cockpit.json5) ───────────────────────
  // To dock back, the MS must be within this radius of the chosen door
  // and moving slower than dockApproachMaxRelVel relative to the parent
  // ship.
  dockApproachRadiusPx: 80,
  dockApproachMaxRelVel: 60,

  // ── Per-sortie resource drain rates ───────────────────────────────────
  // Propellant drained per tactical-second of full thrust input. Thrust
  // magnitude scales the drain linearly (so partial input drains less).
  // Authored so a fresh starter MS at template cap can sustain ~30s of
  // full thrust before going dry; a full sortie cycle with two dock-
  // resupply rounds easily fits inside a typical engagement.
  propellantDrainPerThrustSec: 6,
  // Life-support depletion rate (per tactical-second). Authored so a
  // full lifeSupportMinutes pool covers ~10× a typical sortie window —
  // only `eject + drift` events touch the floor in normal play.
  lifeSupportDrainPerSec: 1,

  // ── W3 (ms-identity) Task 5 — AI wing resupply threshold ──────────────
  // An AI wing member returns to the flagship to resupply once its
  // propellant fraction (currentPropellant / propellantStorage cap) drops
  // below this. Set well above zero so the wing has plenty of propellant
  // left to fly home and dock before stranding — the return leg itself
  // burns propellant at propellantDrainPerThrustSec. Fraction in (0, 1).
  wingResupplyThresholdPct: 0.35,
  // Propellant fraction threshold at which a resupplying wing relaunches.
  // Once the resupply timer completes, the wing waits for propellant to
  // restore to (near) cap before re-engaging. Tolerance allows for
  // floating-point precision margin.
  wingRelaunchPropellantFrac: 0.999,

  // ── W3 (ms-identity) Task 6 — cockpit HUD low-resource cue ─────────────
  // Fraction of cap (propellant / life-support / per-hardpoint ammo) at or
  // below which the cockpit HUD gauge switches to its "low" visual (the
  // player's "dock now or fight on dry?" cue). Deliberately a separate knob
  // from wingResupplyThresholdPct above — that one drives AI wing behavior,
  // this one drives a player-facing display threshold, and the two may
  // diverge in future tuning.
  cockpitLowResourceFrac: 0.3,

  // ── Stranded-MS recovery tug (Design/sortie.md) ───────────────────────
  // Speed of the recovery tug in tactical-arena units per second.
  // Faster than a stranded MS but slower than an MS at full thrust so
  // the round-trip reads as a deliberate hauling pass.
  tugSpeedUnitsPerSec: 160,
  // computers + mechanics threshold (XP) on the dispatching crew member
  // needed to qualify the tug operation. Threshold pulled below the
  // floor of an AE technician (1800 + 600 = 2400) so the comm-panel
  // verb is unlocked once the captain has even moderate crew aboard.
  tugSkillThreshold: 1800,
  // Radius (arena units) within which the tug "grapples" the stranded
  // MS — once inside this radius the tug switches to its returning leg
  // with the MS attached.
  tugGrappleRadiusPx: 24,
  // Radius at which the returning tug hands off to the dock door — the
  // MS enters the door cycle from here.
  tugHandoffRadiusPx: 32,

  // ── W3 (ms-identity) Task 7 — ejection with stakes ────────────────────
  // When an MS hull hits 0 (or life-support drains to 0), the pilot
  // ejects into a drifting escape pod. The pod is NOT a combat row —
  // enemies can't target it (their scans filter to side='player'); it
  // just drifts and can be reached by a hostile that maneuvers onto it.
  ejection: {
    // The pod inherits this fraction of the MS's last velocity as its
    // drift. Ejection kills most of the MS's momentum (the pod is a tiny
    // unpowered capsule), so a small fraction reads right.
    podDriftSpeedFrac: 0.35,
    // Hard cap on the pod's drift speed (arena units/sec) regardless of
    // how fast the MS was going — a pod never streaks across the arena.
    podMaxDriftSpeed: 40,
    // A hostile MS/ship within this radius of the pod opens a capture
    // roll. Larger than a dock approach radius (80) is too generous;
    // this is a close pass, not a fleet sweep.
    podCaptureRadiusPx: 60,
    // Seeded probability that a hostile pass within podCaptureRadiusPx
    // captures the pod. Rolled once per approach episode (re-armed when
    // every hostile leaves the radius) so the flagship can drive an
    // attacker off and buy the pilot another chance. In (0, 1).
    podCaptureProbability: 0.5,
    // Permadeath-ON only: on pod recovery-failure / capture, a seeded
    // survival roll. Below this the pilot survives the loss (rescued-
    // later beat); at or above → the run ends (player Health.dead). This
    // is the probability the run ENDS. In (0, 1).
    podSurvivalRollPermadeath: 0.5,
    // NPC wing pilot pod: seeded probability the fleet recovers the
    // pilot alive. Failure → the pilot NPC dies (crew-loss texture). In
    // (0, 1).
    wingPodRecoveryProbability: 0.7,
    // Conditional on wing-pilot recovery: seeded probability the
    // recovered pilot picked up an injury on the way out. In (0, 1).
    wingPodInjuryProbability: 0.5,
    // Default permadeath state (Design/combat.md: OFF by default — the
    // toggle gates the PLAYER character only; crew loss is independent).
    permadeathDefault: false,
    // Physiology condition applied to a recovered pilot (see
    // data/conditions.json5). Concussion reads as an ejection injury.
    pilotInjuryConditionId: 'concussion',
    // Body part for the (bodyPart-scoped) injury condition above.
    pilotInjuryBodyPart: 'head',
  },
}
