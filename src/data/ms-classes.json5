// Mobile Suit class blueprints — Phase 6.2.5.A + Phase 6.2.5.B.
//
// Phase 6.2.5.B adds `priceFiat` (broker sticker price) and `supplyPerDay`
// (daily supply consumption while stored at any hangar). Issue #63 adds
// `supplyPerRepairDay` and folds both into the daily fleet-supply drain.
// Fighter + MW frames are the first public catalog entries; a proper MS
// broker is faction/research-gated and lands at a later slice
// (Design/fleet.md "AE MS broker proper").
//
// Schema:
//   id            — stable key
//   nameZh        — zh-CN frame name
//   descZh        — zh-CN one-liner
//   priceFiat     — sticker price at the AE vehicle broker (¥)
//   supplyPerDay  — daily fleet-supply drain while in any non-mothballed
//                   hangar (Issue #63)
//   supplyPerRepairDay — additional daily fleet-supply drain while this MS
//                   is in-repair (damaged hull/armor restoring; Issue #63)
//   hullMax       — total hull integrity (HP). 0 = ejection.
//   armorMax      — armor before hull damage
//   topSpeed      — tactical-arena units/sec at full thrust
//   accel         — linear thrust acceleration (units/sec²)
//   decel         — passive deceleration when no thrust input
//   angularAccel  — radians/sec² of steering torque
//   maxAngVel     — radians/sec hard cap on angular velocity
//   propellantStorage — Phase 6.2.5.C; per-sortie propellant cap. Drains
//                   under thrust during cockpit play; hitting zero strands
//                   the MS (drift, can still fire). Resupply at dock
//                   restores to cap.
//   lifeSupportMinutes — Phase 6.2.5.C; pilot life-support pool in
//                   tactical-minutes. Long enough that no normal sortie
//                   touches the floor — only `eject + drift` events test
//                   it. Authored generously per Design/sortie.md.
//   frameSlots    — Phase 6.2.5.C; integer slot budget for bolt-on frame
//                   mods (extended tank, autoloader, …). Either a mod
//                   fits or it doesn't — no OP/flux math.
//   hardpoints[]  — mounting points the player can equip weapons into
//     id            — stable key used in mountedWeapons Record
//     type          — 'small-arms' | 'medium-beam' | 'missile-rack'
//     firingArcDeg  — arc in degrees
//     facingDeg     — default facing angle in degrees (0 = forward)
//     defaultWeaponId — weapon id from ms-weapons.json5 mounted at boot
//   ai            — NPC pilot directive

{
  ms: [
    {
      id: 'gm_pre',
      nameZh: '原型 GM',
      descZh: 'AE 早期评估机型；机库刚塞下一台。装甲薄但敏捷。',
      priceFiat: 380000,
      supplyPerDay: 0.4,
      supplyPerRepairDay: 1.5,
      hullMax: 320,
      armorMax: 80,
      topSpeed: 180,
      accel: 220,
      decel: 110,
      angularAccel: 12,
      maxAngVel: 4.5,
      // Phase 6.2.5.C — sortie resources + frame mod budget. 240 fuel /
      // 6 propellantDrainPerThrustSec ≈ 40s sustained full thrust before
      // drift, comfortably more than one engagement's typical thruster
      // budget. Life-support generous (15 in-tactical minutes = ~10×
      // a routine sortie). Three slots so the player can experiment
      // with mod combinations without a clean GM being a pile of empty
      // racks.
      propellantStorage: 240,
      lifeSupportMinutes: 15,
      frameSlots: 3,
      hardpoints: [
        {
          id: 'hp-0',
          type: 'small-arms',
          firingArcDeg: 60,
          facingDeg: 0,
          defaultWeaponId: 'ms-beamRifle',
        },
      ],
      ai: {
        aggression: 0.7,
        retreatThresholdPct: 0.15,
        maintainRange: 130,
      },
    },
    {
      // Phase 6.2.5.B — first public AE catalog entry. Civilian-grade
      // fighter frame; weaker hull than a GM but cheap and broker-available
      // in 0077. Same single-hardpoint shape so the existing weapon-swap
      // verb covers it without UI changes.
      id: 'civFighter',
      nameZh: '通用战斗机',
      descZh: 'AE 早期民用-军用混编战斗机。装甲单薄，但适合护航与巡逻任务。',
      priceFiat: 240000,
      supplyPerDay: 0.3,
      supplyPerRepairDay: 1,
      hullMax: 200,
      armorMax: 40,
      topSpeed: 220,
      accel: 260,
      decel: 130,
      angularAccel: 14,
      maxAngVel: 5.0,
      // Phase 6.2.5.C — fighter frame: smaller propellant tank (150 vs
      // 240 on the GM, so a fighter's longer-thrust profile bites
      // sooner), shorter life-support (cockpit assemblies bias to
      // cheaper, less padded), tighter frame budget (2 slots).
      propellantStorage: 150,
      lifeSupportMinutes: 10,
      frameSlots: 2,
      hardpoints: [
        {
          id: 'hp-0',
          type: 'small-arms',
          firingArcDeg: 50,
          facingDeg: 0,
          defaultWeaponId: 'ms-beamRifle',
        },
      ],
      ai: {
        aggression: 0.65,
        retreatThresholdPct: 0.2,
        maintainRange: 160,
      },
    },
    {
      // Issue #65 — second public AE catalog entry. Civilian mobile
      // worker: a pre-MS labor/construction frame pressed into a light
      // escort role. Sturdier in the chassis than a fighter but barely
      // armored, slow, and weakly armed — the cheap entry-tier hull a
      // 0077 civilian operator can actually buy. Single small-arms
      // hardpoint (ballistic, not beam) keeps it consistent with the
      // utility role and reuses the existing weapon-swap verb unchanged.
      id: 'mobileWorker',
      nameZh: '通用机动工兵',
      descZh: 'AE 民用机动工兵；本是矿建劳作机，临时挂上实弹枪充当护卫。装甲薄、速度慢，但便宜耐用。',
      priceFiat: 120000,
      supplyPerDay: 0.25,
      supplyPerRepairDay: 0.8,
      hullMax: 160,
      armorMax: 20,
      topSpeed: 120,
      accel: 140,
      decel: 90,
      angularAccel: 10,
      maxAngVel: 3.5,
      // Civilian frame: small propellant tank, generous-enough life
      // support (labor cockpits are pressurized for long shifts), tight
      // 2-slot frame budget.
      propellantStorage: 120,
      lifeSupportMinutes: 12,
      frameSlots: 2,
      hardpoints: [
        {
          id: 'hp-0',
          type: 'small-arms',
          firingArcDeg: 45,
          facingDeg: 0,
          defaultWeaponId: 'ms-ballisticGun',
        },
      ],
      ai: {
        aggression: 0.3,
        retreatThresholdPct: 0.4,
        maintainRange: 200,
      },
    },
  ],
}
