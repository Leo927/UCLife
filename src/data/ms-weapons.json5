// MS-specific weapons — Phase 6.2.5.A.
//
// Distinct from ship weapons (src/data/weapons.json5). MS weapons
// mount on MS hardpoints (type-matched by mountType). The player
// equips these via the hangar terminal's weapon-swap verb.
//
// Schema:
//   id            — stable key
//   nameZh        — zh-CN name
//   descZh        — zh-CN one-liner
//   mountType     — 'small-arms' | 'medium-beam' | 'missile-rack'
//   damage        — per-shot damage
//   range         — max effective range in tactical-arena units
//   chargeSec     — seconds between shots
//   tier          — 1..3 tech tier
//   ammoCapacity  — Phase 6.2.5.C. Per-sortie shots before the weapon
//                   disables for the rest of the sortie until resupply.
//                   Energy weapons declare `Infinity` and never deplete.

{
  msWeapons: [
    {
      id: 'ms-beamRifle',
      nameZh: 'MS 光束步枪',
      descZh: '标准型 MS 光束步枪；精度高，射速适中。',
      mountType: 'small-arms',
      damage: 40,
      range: 230,
      chargeSec: 1.0,
      tier: 1,
      // Energy weapon: drawn off ship power via E-cap. No per-sortie
      // ammo limit; flux/power constraints handled elsewhere.
      ammoCapacity: Infinity,
    },
    {
      id: 'ms-ballisticGun',
      nameZh: 'MS 实弹步枪',
      descZh: '高初速穿甲弹；对装甲伤害更高。',
      mountType: 'small-arms',
      damage: 65,
      range: 180,
      chargeSec: 1.6,
      tier: 1,
      // Ballistic: drum magazine. 30 rounds reads as a realistic mag
      // for a per-MS handheld autocannon analogue; depletion forces a
      // dock-and-resupply or a swap to the beam rifle mid-sortie.
      ammoCapacity: 30,
    },
    {
      id: 'ms-missileRack',
      nameZh: 'MS 导弹架',
      descZh: '追踪导弹；对盾牌效果不佳，对无护盾目标威力强。',
      mountType: 'small-arms',
      damage: 55,
      range: 300,
      chargeSec: 2.2,
      tier: 1,
      // Missile rack: 8-shot pod. Per-sortie scarcity reads canonically
      // for missile loadouts.
      ammoCapacity: 8,
    },
  ],
}
