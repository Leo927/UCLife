// Enemy ship class library — Starsector-shape stat block.
//
// Schema (see enemyShips.ts):
//   id, nameZh, descZh
//   hullMax, armorMax, fluxMax, fluxDissipation, hasShield, shieldEfficiency
//   topSpeed, accel, decel, angularAccel, maxAngVel
//   (Movement is Newtonian: ships accumulate velocity from thrust × accel, glide
//   under decel when not thrusting, cap at topSpeed, and steer via angularAccel
//   torque clamped to maxAngVel. See systems/combat.ts.)
//   mounts[]   — same hardpoint shape as ship-classes.json5
//   defaultWeapons[] — ordered list bound to mounts
//   ai — { aggression: 0..1, retreatThresholdPct: 0..1, maintainRange: number }
//   salvage[] — Issue #64. MS-parts loot dropped when this hull is broken
//     down at post-combat. Each entry: { partId, kind: 'weapon'|'frameMod',
//     chance: 0..1, qty }. Rolled with the seeded combat RNG (deterministic).
//     partId must resolve to ms-weapons.json5 / ms-frame-mods.json5.
//
// Ship-level energy shields don't exist in UC, so all ship classes here
// declare hasShield=false. Damage routes straight to armor + hull. Flux
// still gates weapon power output. The shield mechanism stays reachable
// in code for end-game MS that earn shield generators.
//
// Phase 6.0 spine ships three classes. pirateLight is the baseline learner;
// pirate_skirmisher and pirate_raider are the campaign-map roster referenced
// by space-entities.json5.
//
// pirate_corsair is the first-sortie encounter: a tougher, longer-lived picket
// (hull outlasts a light freighter's ~1-minute grind) carrying ONE weak beam,
// so it can't threaten the 800-hull freighter while the captain is off the
// bridge. That makes leaving the helm to sortie an MS a SAFE first lesson under
// the one-clock model (the fight runs on AI while you're away); the flagship
// finishes it once you retake the helm. See space-entities.json5 for its role
// as the Von Braun home picket.

{
  ships: [
    {
      id: 'pirateLight',
      nameZh: '海盗轻型护卫舰',
      descZh: '老旧的吉翁式轻型护卫舰，被海盗改装。',
      hullMax: 500,
      armorMax: 100,
      fluxMax: 1000,
      fluxDissipation: 50,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 70,
      accel: 80,
      decel: 40,
      angularAccel: 5.0,
      maxAngVel: 1.8,
      mounts: [
        { idx: 0, size: 'small', firingArcDeg: 40, facingDeg: 0 },
        { idx: 1, size: 'small', firingArcDeg: 30, facingDeg: 0 },
      ],
      defaultWeapons: ['pirateBeamMk0', 'pirateBeamMk0'],
      ai: {
        aggression: 0.55,
        retreatThresholdPct: 0.2,
        // Distance the AI tries to maintain from the player ship in arena
        // units. Pirate light frigates close in to brawling range.
        maintainRange: 160,
      },
      salvage: [
        { partId: 'ms-beamRifle', kind: 'weapon', chance: 0.4, qty: 1 },
      ],
      // Issue #71 — recoverables. recoverTemplateId is the ship-classes.json5
      // template a Recover'd hull joins the fleet as (the pre-authored
      // hostile-eligible class). crewRequired sizes the prize-crew gate:
      // Recover needs idle flagship crew ≥ ceil(crewRequired / prizeCrewDivisor).
      recoverTemplateId: 'lunarMilitia',
      crewRequired: 8,
    },

    // First-sortie encounter. A tougher, faster picket than pirateLight — hull
    // sized so it OUTLASTS the player's off-helm MS sortie (a light freighter's
    // beams grind it down over ~a minute of continuous fire, and the bounded
    // sortie bursts never run that long), then is finished when the player
    // retakes the helm. ONE weak beam so the freighter (800 hull) is never in
    // danger while the captain is off the bridge — the safe first lesson that
    // you CAN leave the helm mid-fight. Cannot flee (retreatThresholdPct 0) so
    // the engagement always resolves to a guaranteed kill. topSpeed 90 > the
    // freighter's 60 but < gm_pre's 180, so the sortied MS can run it down.
    {
      id: 'pirate_corsair',
      nameZh: '海盗突袭艇',
      descZh: '结实的海盗突袭艇；比寻常护卫艇更耐揍，货船的轻炮要磨上好一阵才能击穿。',
      hullMax: 1300,
      armorMax: 250,
      fluxMax: 900,
      fluxDissipation: 55,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 90,
      accel: 100,
      decel: 50,
      angularAccel: 6.0,
      maxAngVel: 2.2,
      mounts: [
        { idx: 0, size: 'small', firingArcDeg: 40, facingDeg: 0 },
      ],
      defaultWeapons: ['pirateBeamMk0'],
      ai: {
        aggression: 0.6,
        retreatThresholdPct: 0.0,
        maintainRange: 150,
      },
      salvage: [
        { partId: 'ms-beamRifle', kind: 'weapon', chance: 0.4, qty: 1 },
      ],
      recoverTemplateId: 'lunarMilitia',
      crewRequired: 6,
    },

    // Patrol-grade skirmisher — the standard pirate presence in the lunar shoal
    // zone and near-moon orbit. Faster than pirateLight but equally fragile;
    // a stock lightFreighter can trade with two of these if the player manages
    // flux. Used by all pirate_skirmisher entries in space-entities.json5.
    {
      id: 'pirate_skirmisher',
      nameZh: '海盗巡逻艇',
      descZh: '轻型海盗巡逻艇；活跃于月球轨道附近，机动性好但装甲薄弱。',
      hullMax: 550,
      armorMax: 110,
      fluxMax: 1100,
      fluxDissipation: 50,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 80,
      accel: 90,
      decel: 50,
      angularAccel: 6.0,
      maxAngVel: 2.0,
      mounts: [
        { idx: 0, size: 'small', firingArcDeg: 40, facingDeg: 0 },
        { idx: 1, size: 'small', firingArcDeg: 30, facingDeg: 0 },
      ],
      defaultWeapons: ['pirateBeamMk0', 'pirateBeamMk0'],
      ai: {
        aggression: 0.60,
        retreatThresholdPct: 0.20,
        maintainRange: 150,
      },
      salvage: [
        { partId: 'ms-beamRifle', kind: 'weapon', chance: 0.5, qty: 1 },
        { partId: 'subThruster', kind: 'frameMod', chance: 0.3, qty: 1 },
      ],
      recoverTemplateId: 'lunarMilitia',
      crewRequired: 8,
    },

    // Heavy raider — anchors the outer-belt pirate groups and the sturdier
    // near-moon patrol. More hull and a ballistic mount make it a threat even
    // to a lightly-upgraded lightFreighter. Used by pirate_raider entries in
    // space-entities.json5.
    {
      id: 'pirate_raider',
      nameZh: '海盗突击舰',
      descZh: '改装的吉翁式突击舰；装甲厚实，携带实弹炮，是近月轨道上最危险的海盗船型。',
      hullMax: 900,
      armorMax: 200,
      fluxMax: 1700,
      fluxDissipation: 68,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 55,
      accel: 50,
      decel: 25,
      angularAccel: 3.0,
      maxAngVel: 1.2,
      mounts: [
        // Forward beam, ballistic, and a side-slung beam covering starboard.
        { idx: 0, size: 'small', firingArcDeg: 40, facingDeg: 0 },
        { idx: 1, size: 'small', firingArcDeg: 30, facingDeg: 0 },
        { idx: 2, size: 'small', firingArcDeg: 60, facingDeg: 90 },
      ],
      defaultWeapons: ['pirateBeamMk0', 'ballisticMk1', 'pirateBeamMk0'],
      ai: {
        aggression: 0.75,
        retreatThresholdPct: 0.15,
        maintainRange: 130,
      },
      // The raider always yields its ballistic gun when broken down
      // (chance 1.0) — the heavy pirate hull is a reliable parts source.
      // Smoke fixtures engage this class and assert the guaranteed drop.
      salvage: [
        { partId: 'ms-ballisticGun', kind: 'weapon', chance: 1.0, qty: 1 },
        { partId: 'armorPlating', kind: 'frameMod', chance: 0.5, qty: 1 },
      ],
      // The raider is capital-grade for recovery purposes (heavier hull,
      // bigger prize crew); it still maps to the lunarMilitia template
      // until a dedicated heavy hull is authored.
      recoverTemplateId: 'lunarMilitia',
      crewRequired: 16,
    },

    // W3 (ms-identity) Task 2 — hostile mobile suits. `isMs: true` rows
    // spawn as small/fast CombatShipState entries (see spawnEnemyMsComplement
    // in systems/combat.ts) instead of ship-scale hulls; the `pilot` block
    // is consumed by Task 4's enemy-MS AI (reaction delay, aim jitter,
    // boost-use probability). Both frames are junker-grade AE/Zeon
    // salvage-yard builds — deliberately below the player's starter gm_pre
    // frame (hullMax 320 / armorMax 80 / topSpeed 180, see ms-classes.json5)
    // on every combat axis, so a mobileWorker pilot can win 1v1 with care
    // and a gm_pre pilot wins comfortably. mounts/defaultWeapons use the
    // ship weapon catalog (weapons.json5), matching every other row in this
    // file — enemy MS fight through the same tactical §4 fire loop as ships,
    // not the player-only ms-weapons hardpoint system.
    {
      id: 'pirate_junkerMs',
      nameZh: '海盗拼装MS',
      descZh: '海盗东拼西凑焊接的老旧MS机体；装甲单薄但机动灵活，惯于欺近缠斗。',
      isMs: true,
      hullMax: 220,
      armorMax: 35,
      fluxMax: 0,
      fluxDissipation: 0,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 160,
      accel: 190,
      decel: 100,
      angularAccel: 11,
      maxAngVel: 4.0,
      mounts: [
        { idx: 0, size: 'small', firingArcDeg: 50, facingDeg: 0 },
      ],
      defaultWeapons: ['pirateBeamMk0'],
      ai: {
        aggression: 0.7,
        retreatThresholdPct: 0.2,
        // Brawler — closes tight before it fires.
        maintainRange: 90,
      },
      pilot: {
        reactionSec: 0.5,
        aimJitterRad: 0.14,
        boostUse: 0.55,
      },
      // W3 (ms-identity) Task 3 — small relative to the ship default (12,
      // combat.json5). Boost mirrors the brawler's high boostUse above:
      // a solid vernier kick it uses often to close distance.
      hitRadiusPx: 9,
      boost: { speedMul: 1.5, durationSec: 2.0, cooldownSec: 5, propellantCost: 20 },
      salvage: [
        { partId: 'ms-beamRifle', kind: 'weapon', chance: 0.3, qty: 1 },
      ],
      recoverTemplateId: 'lunarMilitia',
      crewRequired: 1,
    },
    {
      id: 'pirate_junkerMs_gun',
      nameZh: '海盗拼装MS·炮击型',
      descZh: '加挂实弹炮的海盗拼装MS；比轻型机体笨重迟缓，靠射程压制目标。',
      isMs: true,
      hullMax: 260,
      armorMax: 45,
      fluxMax: 0,
      fluxDissipation: 0,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 130,
      accel: 150,
      decel: 80,
      angularAccel: 8,
      maxAngVel: 3.0,
      mounts: [
        { idx: 0, size: 'small', firingArcDeg: 40, facingDeg: 0 },
      ],
      defaultWeapons: ['ballisticMk1'],
      ai: {
        aggression: 0.5,
        retreatThresholdPct: 0.25,
        // Fire support — hangs back at ballistic range rather than closing.
        maintainRange: 170,
      },
      pilot: {
        reactionSec: 0.9,
        aimJitterRad: 0.08,
        boostUse: 0.2,
      },
      // Bulkier gun-mule frame — slightly bigger than the brawler but
      // still small vs. the ship default (12). Weaker/rarer boost
      // (matches its low boostUse above — it prefers to hang back).
      hitRadiusPx: 10,
      boost: { speedMul: 1.3, durationSec: 1.5, cooldownSec: 7, propellantCost: 20 },
      salvage: [
        { partId: 'ms-ballisticGun', kind: 'weapon', chance: 0.4, qty: 1 },
      ],
      recoverTemplateId: 'lunarMilitia',
      crewRequired: 1,
    },
  ],
}
