// Unified world-object visual registry. Every renderable thing on
// the ground (beds, interactables, doors, walls, bar seats,
// buildings, …) declares its visual definition here. One file,
// category-namespaced — adding a new piece of furniture (chair,
// table, lamp, painting, garbage) is a row under the right category,
// not a new config file.
//
// Common fields:
//   - `w`, `h`     drawn footprint in world pixels (omit for objects
//                  whose footprint is per-instance, e.g. walls/doors)
//   - `fill`,
//     `stroke`     procedural-fallback palette; required for now,
//                  optional once every variant has an `assetId`
//   - `assetId`    optional reference into `art.json5`'s catalog
//                  when present, the renderer paints the sprite at
//                  (w × h); otherwise it draws procedurally
//   - `label`      zh-CN display string where the renderer needs one
{
  // Beds — keyed by tier. Footprint varies per tier; flop is the
  // only one with art yet.
  beds: {
    flop:      { w: 32, h: 32, fill: 0x262626, stroke: 0x737373, label: '投币床',  assetId: 'bed-flop' },
    dorm:      { w: 22, h: 14, fill: 0x3a2e1a, stroke: 0xa78b4a, label: '宿舍床' },
    apartment: { w: 26, h: 16, fill: 0x1e3a8a, stroke: 0x60a5fa, label: '床' },
    lounge:    { w: 26, h: 14, fill: 0x3a2c0a, stroke: 0xc9a047, label: '员工沙发' },
    luxury:    { w: 28, h: 18, fill: 0x0e2a3a, stroke: 0x22d3ee, label: '高级床' },
  },

  // Interactables — keyed by ECS kind. All currently render as a
  // 28×28 colored badge; w/h is encoded here so individual kinds
  // can grow into proper sprites later without renderer changes.
  interactables: {
    eat:             { w: 28, h: 28, fill: 0x7c2d12, stroke: 0xea580c },
    sleep:           { w: 28, h: 28, fill: 0x1e3a8a, stroke: 0x3b82f6 },
    wash:            { w: 28, h: 28, fill: 0x155e75, stroke: 0x06b6d4 },
    work:            { w: 28, h: 28, fill: 0x3b1e7a, stroke: 0xa855f7 },
    bar:             { w: 28, h: 28, fill: 0x7f1d1d, stroke: 0xef4444 },
    gym:             { w: 28, h: 28, fill: 0x3a2c0a, stroke: 0xc9a047 },
    tap:             { w: 28, h: 28, fill: 0x1e293b, stroke: 0x64748b },
    scavenge:        { w: 28, h: 28, fill: 0x3a2e1a, stroke: 0xa3a3a3 },
    rough:           { w: 28, h: 28, fill: 0x262626, stroke: 0x737373 },
    transit:         { w: 28, h: 28, fill: 0x134e4a, stroke: 0x2dd4bf },
    ticketCounter:   { w: 28, h: 28, fill: 0x1e3a8a, stroke: 0x60a5fa },
    // Orbital-lift kiosk. Magenta to read as distinct from the
    // airport ticket counter (warm blue) and the intra-scene transit
    // kiosk (teal). Same blue-ish family but pushed toward violet so
    // the two cross-scene transit primitives don't blur together.
    orbitalLift:     { w: 28, h: 28, fill: 0x4c1d95, stroke: 0xa78bfa },
    boardShip:       { w: 28, h: 28, fill: 0x0c4a6e, stroke: 0x38bdf8 },
    disembarkShip:   { w: 28, h: 28, fill: 0x1e293b, stroke: 0x94a3b8 },
    helm:            { w: 28, h: 28, fill: 0x3a1f4a, stroke: 0xa78bfa },
    // Owner-control hue: deep amber + bright gold, distinct from the
    // service-side palette (those are scenery-only and carry no
    // Interactable). 'manage' reads as 'this is your facility'.
    manage:          { w: 28, h: 28, fill: 0x713f12, stroke: 0xfbbf24 },
    // Captain's desk — pre-launch readiness summary. Same warm
    // palette family as helm/manage so ship-command interactables
    // read as one group on the floor.
    captainsDesk:    { w: 28, h: 28, fill: 0x422006, stroke: 0xfcd34d },
    // Comm panel in the captain's office. Cool teal so it reads as
    // a sibling-but-distinct kiosk from the warm desk.
    commPanel:       { w: 28, h: 28, fill: 0x0f3a3a, stroke: 0x2dd4bf },
    // Brig occupant list. Muted iron tone to read as hostile-but-
    // confined; distinct from the warm command palette.
    brig:            { w: 28, h: 28, fill: 0x3a1212, stroke: 0xf87171 },
    // War-room plot table. Deep indigo + cool steel — reads as the
    // strategic/composition surface, distinct from the warm ship-
    // command interactables and the iron-toned brig.
    warRoom:         { w: 28, h: 28, fill: 0x1e1b4b, stroke: 0x818cf8 },
    // Climb-into-MS interactable on the hangar bay floor. Cool blue
    // to match the friendly-MS color used in the tactical arena.
    climbIntoMs:     { w: 28, h: 28, fill: 0x172554, stroke: 0x60a5fa },
  },

  // Doors — keyed by gating variant. Rect dimensions are
  // per-instance (from procgen); only the palette varies here.
  doors: {
    open:         { fill: 0x1f1f24, stroke: 0x71717a },
    factionGated: { fill: 0x3a2c0a, stroke: 0xc9a047 },
    bedKeyed:     { fill: 0x3a2206, stroke: 0xfbbf24 },
  },

  // Walls — single visual. Rect dimensions are per-instance.
  walls: {
    default: { fill: 0x3f3f46, stroke: 0x52525b },
  },

  // Bar seats — single visual today; promoted to a category so each
  // bar variant (cafe, lounge, dive) can grow its own row later.
  barSeats: {
    default: { w: 18, h: 14, fill: 0x7f1d1d, stroke: 0xef4444 },
  },

  // Building outlines (dashed rect on the floor).
  buildings: {
    default: { fill: 0x32323c, stroke: 0x2f2f3a },
  },
}
