// Player ship class blueprints — Starsector-shape stat block.
//
// A ship's combat performance is the product of:
//   hullMax           — total hull integrity (HP). 0 = destroyed.
//   armorMax          — armor before hull damage. Reduces incoming damage
//                       proportionally to remaining armor pct.
//   fluxMax           — capacitor budget for weapon firing (and, where
//                       installed, shields).
//   fluxDissipation   — flux/sec the ship vents passively
//   hasShield         — whether the ship mounts an energy shield generator.
//                       UC default is false: ship-level energy shields don't
//                       exist in UC. The flux/shield mechanism is reserved
//                       for end-game MS that earn shield generators.
//   shieldEfficiency  — multiplier on incoming-damage flux conversion
//                       when shields are up. 1 = neutral; <1 = better.
//                       Irrelevant when hasShield = false.
//   topSpeed          — tactical-arena units/sec at full throttle (hard cap)
//   accel             — linear thrust acceleration (arena units/sec²) when WASD input is held
//   decel             — passive deceleration applied when no thrust input — gives the ship inertia + glide
//   angularAccel      — radians/sec² of steering torque (used both to spin the
//                       helm toward the aim cursor and to bleed off angular velocity when idle)
//   maxAngVel         — radians/sec hard cap on angular velocity (turn rate ceiling)
//
// AI block (`ai`):
//   When the player provides no movement input, the player's ship runs the
//   same AI loop as enemies — closing to / strafing at / backing away from
//   maintainRange relative to the nearest hostile. Player input/aim
//   overrides this directive on the player ship; enemies always run AI.
//   aggression           — weapon-charge multiplier (0..1; not used for player firing).
//   retreatThresholdPct  — hull % below which AI flees (0..1; not yet wired for player).
//   maintainRange        — preferred standoff distance from the nearest hostile, arena units.
//
// Logistics (campaign map):
//   fuelMax / suppliesMax — campaign-map travel resources
//   crewMax               — hard cap on crew aboard
//
// Hardpoints (`mounts`):
//   array of `{ idx, size: 'small' | 'medium' | 'large', firingArcDeg,
//   facingDeg }`. `firingArcDeg` is the total firing arc in degrees
//   (e.g. 30 = ±15° around the mount centerline). `facingDeg` is the
//   mount center direction in degrees relative to ship heading
//   (0 = forward, +90 = starboard). Each turret on a ship can declare
//   its own arc — different mounts on the same ship can cover
//   different angles. Weapons must match or be smaller than the mount
//   size.
//
// Walkable interior:
//   rooms[]   — list of room rectangles in ship-local tile space.
//               Each room may declare interactables[] — kiosks the
//               player clicks (kind matches the InteractableKind union;
//               label is zh-CN; offset is in tiles relative to room
//               center, default {0,0}).
//   doors[]   — adjacencies between rooms (procgen/ship.ts converts to
//               Wall + Door entities). The walkable layer survives the
//               Starsector pivot because it carries downtime, mode-
//               switch transit, and story beats — but not combat UI.
//
// Phase 6.0 ships exactly one class: the light freighter the player
// buys as a Phase 6 capstone. Phase 6.2+ adds frigates / destroyers /
// carriers by appending entries here.

// Each row also declares `hangarSlotClass: 'ms' | 'smallCraft' | 'capital'`.
// Drives the hangar capacity gate at 6.2.C1+ purchase + delivery: a hull
// only fits in a hangar whose slot hierarchy can accept its class (slots
// at or above the ship's class accept it; capital ⊇ ms ⊇ smallCraft).
// `lightFreighter` is the existing flagship; UC-canon civilian freighters
// slot into `smallCraft` bays. A future Pegasus-class capital declares
// `'capital'` so the Von Braun drydock gates it correctly.
{
  ships: [
    {
      id: 'lightFreighter',
      nameZh: '轻型货船 · 改装型',
      descZh: 'AE 二手货船底盘改装的轻型武装船。机库勉强能容下一台 MS。',
      shipClass: 'civilian',
      hangarSlotClass: 'smallCraft',
      hullMax: 800,
      armorMax: 200,
      fluxMax: 1500,
      fluxDissipation: 75,
      // No shield — ship-level energy shields don't exist in UC; armor +
      // hull is the entire defensive budget. Flux still gates weapon power
      // output. The shield mechanism is preserved in code for end-game MS.
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 60,
      accel: 60,
      decel: 30,
      angularAccel: 4.0,
      maxAngVel: 1.5,
      crMax: 100,
      // W1 Task 7 — 16 made vonBraun's own 12-fuel takeoff cost alone eat
      // 75% of the tank, leaving no budget for a round trip to any
      // patrol and back. 60 puts a standard sortie (takeoff + intercept
      // + dock) at roughly half the tank — see fuel-budget.spec.ts.
      fuelMax: 60,
      suppliesMax: 40,
      // Per-day supply drain (Starsector model — aggregated across the
      // fleet by the daily drain tick at 6.2.F). A civilian light hull
      // burns a token amount; bigger hulls (Pegasus, etc.) author higher.
      supplyPerDay: 4,
      // Issue #69 — tactical deployment-points cost. A civilian light hull
      // is cheap to field; a capital carrier (pegasusClass) costs far more.
      dpCost: 3,
      crewMax: 4,
      // Civilian-spec hulls in the design get brigCapacity: 0; the
      // lightFreighter ships a refit 2-cell brig so the named-hostile
      // capture loop has somewhere to go in 6.2. A clean civilian
      // variant — when added — would set brigCapacity: 0.
      brigCapacity: 2,
      // Phase 6.2.5 — internal MS bay. lightFreighter lore: "机库勉强能容下
      // 一台 MS" (hangar can barely fit one MS). Single internal slot.
      hangarCapacity: 1,
      // W4.3 — forward-repair band. A civilian refit's makeshift deck patches
      // to 80% and can't touch a unit below 40% (baseline; a carrier tender
      // would author a lower floor).
      onShipRepairCap: 0.8,
      onShipRepairFloor: 0.4,
      // Phase 6.2.5.C — physical launch/recovery doors authored per
      // hull. The lightFreighter ships with one port-side cradle door:
      // an MS spawns at (ship.pos + door.position rotated by ship.heading)
      // with initial velocity along (door.facing + ship.heading). One
      // door + one bay means no queueing aboard this hull. See
      // Design/sortie.md §Hangar door / launch position.
      hangarDoors: [
        { id: 'port-cradle', position: { x: 0, y: -40 }, facing: -90, bayId: 'bay-1' },
      ],
      // Bridge officer roster. 6.2 wires the adjutant only — comm-panel
      // chatter (launch, dock, threshold, leave-bridge) reads the name
      // from here instead of the 6.1 hardcoded "凯文". 6.2.5 expands the
      // officer wall with chief mech / chief medical / etc.
      officers: {
        adjutant: { name: '凯文', title: '副官' },
      },
      mounts: [
        // Two forward small hardpoints, both narrow ±15° arcs.
        { idx: 0, size: 'small', firingArcDeg: 30, facingDeg: 0 },
        { idx: 1, size: 'small', firingArcDeg: 30, facingDeg: 0 },
      ],
      // Issue #165 — both forward hardpoints armed at boot (mount 1
      // previously shipped empty; only the fire-control smoke's test-only
      // armWeaponMountForTest workaround fired it).
      defaultWeapons: ['beamMk1', 'beamMk1'],
      ai: {
        aggression: 0.5,
        retreatThresholdPct: 0.2,
        // Light freighter prefers a brawler standoff range — same band as
        // pirateLight so a no-input player and a default enemy meet midway.
        maintainRange: 200,
      },
      // Phase W1 (Task 4) — starter hull, purchasable from the VB AE sales
      // rep before the player owns any ship. Priced at ~21 median job-day
      // wages (median wage across every src/config/jobs.json5 catalog
      // entry = 200/day → 21 × 200 = 4200), so a player working a median
      // job can afford it inside a month without a grind. See
      // src/data/ship-classes.test.ts for the reachability invariant.
      priceFiat: 4200,
      // Captain's office sits in its own row above the bridge so it's
      // adjacent (south door into the bridge). Hosts two kiosks: the
      // readiness-summary desk (Phase 6.0) and the comm panel (Phase
      // 6.2 — officer chatter, named-hostile context; prisoner verbs
      // land at 6.2.5). The brig is two doors aft of the captain's
      // office; the player walks from desk → comm to brig in roughly
      // a hallway's length, so the captain ↔ POW loop reads diegetic.
      rooms: [
        {
          id: 'captainsOffice', nameZh: '船长室', bounds: { x: 0, y: 0, w: 2, h: 2 },
          interactables: [
            { kind: 'captainsDesk', label: '出航简报', offset: { dx: -0.5, dy: -0.5 } },
            { kind: 'commPanel',    label: '通讯面板', offset: { dx: 0.5,  dy: -0.5 } },
          ],
        },
        {
          id: 'bridge', nameZh: '舰桥', bounds: { x: 0, y: 2, w: 2, h: 2 },
          interactables: [
            { kind: 'helm', label: '操舵 / 航行', offset: { dx: 0, dy: -0.5 } },
            // Phase 6.2.E1 — war-room plot table on the flagship bridge.
            // The lightFreighter doesn't have a dedicated warRoom room
            // (the Pegasus does), so the plot table sits on the bridge
            // opposite the helm. Offset clears the helm so the player
            // can walk up to either kiosk without ambiguity.
            { kind: 'warRoom', label: '战略图台', offset: { dx: 0, dy: 0.5 } },
          ],
        },
        {
          // W4.2 — furnished crew quarters. Four racks fill the 2×2 room:
          // the captain's bunk + three crew bunks (offsets = the four tile
          // centres). Rent-free 'bunk' Bed tier attached at spawn.
          id: 'crewQ',      nameZh: '船员舱',   bounds: { x: 2, y: 2, w: 2, h: 2 },
          interactables: [
            { kind: 'sleep', label: '舰长铺位', offset: { dx: -0.5, dy: -0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: 0.5,  dy: -0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: -0.5, dy: 0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: 0.5,  dy: 0.5 } },
          ],
        },
        {
          // W4.2 — mess. One eat station the player + crew both use; crew
          // draw the shared ship supply pool per meal (config).
          id: 'mess',       nameZh: '餐厅',     bounds: { x: 4, y: 2, w: 2, h: 2 },
          interactables: [
            { kind: 'eat', label: '餐台', offset: { dx: -0.5, dy: -0.5 } },
          ],
        },
        { id: 'engineRoom', nameZh: '引擎室',   bounds: { x: 0, y: 4, w: 2, h: 2 } },
        { id: 'medbay',     nameZh: '医务室',   bounds: { x: 2, y: 4, w: 2, h: 2 } },
        {
          id: 'hangarBay', nameZh: '机库', bounds: { x: 4, y: 4, w: 2, h: 2 },
          interactables: [
            { kind: 'disembarkShip', label: '下船', offset: { dx: 0, dy: -0.5 } },
            // Phase 6.2.5.A — climbIntoMs kiosk removed; the MS sprite
            // entity is the climb-in walk-up (spawned by refreshMsLayout).
          ],
        },
        // Phase 6.2 — brig as ship-class room. Capacity is gated by
        // brigCapacity above; per-prisoner verbs (interrogate / ransom
        // / etc.) land at 6.2.5. The 'brig' interactable opens the
        // occupant list panel. Sits east of the captain's office on
        // the top row so the captain ↔ POW loop is a one-door walk.
        {
          id: 'brig', nameZh: '禁闭室', bounds: { x: 2, y: 0, w: 2, h: 2 },
          interactables: [
            { kind: 'brig', label: '查看囚犯', offset: { dx: 0, dy: -0.5 } },
          ],
        },
      ],
      doors: [
        { roomA: 'captainsOffice', roomB: 'bridge',   side: 'south' },
        { roomA: 'captainsOffice', roomB: 'brig',     side: 'east' },
        { roomA: 'brig',       roomB: 'crewQ',      side: 'south' },
        { roomA: 'bridge',     roomB: 'crewQ',      side: 'east' },
        { roomA: 'crewQ',      roomB: 'mess',       side: 'east' },
        { roomA: 'engineRoom', roomB: 'medbay',     side: 'east' },
        { roomA: 'medbay',     roomB: 'hangarBay',  side: 'east' },
        { roomA: 'bridge',     roomB: 'engineRoom', side: 'south' },
        { roomA: 'crewQ',      roomB: 'medbay',     side: 'south' },
        { roomA: 'mess',       roomB: 'hangarBay',  side: 'south' },
      ],
      // W4.1 — duty stations manned when underway. Roster order: captain →
      // bridge (the helm watch), then crew → engine / medbay / hangar. Anchors
      // sit at each room's center (offset {0,0}), which is open floor.
      crewStations: [
        { roomId: 'bridge',     offset: { dx: 0, dy: 0 } },
        { roomId: 'engineRoom', offset: { dx: 0, dy: 0 } },
        { roomId: 'medbay',     offset: { dx: 0, dy: 0 } },
        { roomId: 'hangarBay',  offset: { dx: 0, dy: 0 } },
      ],
    },

    // Phase 6.2.C1 — the AE VB sales rep's second product (Task 4 of the
    // W1 playable loop adds the cheaper `lightFreighter` starter hull as
    // the rep's first). UC-flavored civilian-grade light escort: a
    // Federation-surplus shuttle-frame refitted with two small mounts.
    // Light enough to dock in a surface hangar's `smallCraft` slot, mean
    // enough to fight off a single pirate raid — the step up once the
    // player has outgrown the starter hull.
    {
      id: 'lunarMilitia',
      nameZh: '月面民兵护卫艇',
      descZh: '月面民兵改装的小型护卫艇 · 联邦报废的穿梭机底盘 + 两门小型武器。 AE 在二手市场上整修后转售给商船团。',
      shipClass: 'merc',
      hangarSlotClass: 'smallCraft',
      hullMax: 400,
      armorMax: 100,
      fluxMax: 800,
      fluxDissipation: 50,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 80,
      accel: 80,
      decel: 40,
      angularAccel: 5.0,
      maxAngVel: 1.8,
      crMax: 100,
      fuelMax: 10,
      suppliesMax: 25,
      // Phase 6.2.F — smaller hull than the flagship lightFreighter (4),
      // so a half-rate drain keeps the demo readable when a second hull
      // joins the fleet.
      supplyPerDay: 2,
      // Issue #69 — light escort, cheapest hull to field.
      dpCost: 2,
      crewMax: 2,
      brigCapacity: 0,
      officers: {
        adjutant: { name: '艾莉森', title: '副官' },
      },
      mounts: [
        { idx: 0, size: 'small', firingArcDeg: 30, facingDeg: 0 },
        { idx: 1, size: 'small', firingArcDeg: 30, facingDeg: 0 },
      ],
      // Issue #165 — both hardpoints armed; beam + ballistic mix gives the
      // step-up hull a matchup edge the beam-only lightFreighter lacks.
      defaultWeapons: ['beamMk1', 'ballisticMk1'],
      ai: {
        aggression: 0.6,
        retreatThresholdPct: 0.25,
        maintainRange: 220,
      },
      priceFiat: 35000,
      rooms: [
        {
          id: 'bridge', nameZh: '舰桥', bounds: { x: 0, y: 0, w: 2, h: 2 },
          interactables: [
            { kind: 'helm', label: '操舵 / 航行', offset: { dx: 0, dy: -0.5 } },
          ],
        },
        { id: 'crewQ',      nameZh: '船员舱',   bounds: { x: 2, y: 0, w: 2, h: 2 } },
        { id: 'engineRoom', nameZh: '引擎室',   bounds: { x: 0, y: 2, w: 2, h: 2 } },
        {
          id: 'hangarBay', nameZh: '机库', bounds: { x: 2, y: 2, w: 2, h: 2 },
          interactables: [
            { kind: 'disembarkShip', label: '下船', offset: { dx: 0, dy: -0.5 } },
          ],
        },
      ],
      doors: [
        { roomA: 'bridge',     roomB: 'crewQ',      side: 'east' },
        { roomA: 'bridge',     roomB: 'engineRoom', side: 'south' },
        { roomA: 'crewQ',      roomB: 'hangarBay',  side: 'south' },
        { roomA: 'engineRoom', roomB: 'hangarBay',  side: 'east' },
      ],
      // W4.1 — two-hand crew: captain on the bridge, deckhand in the engine room.
      crewStations: [
        { roomId: 'bridge',     offset: { dx: 0, dy: 0 } },
        { roomId: 'engineRoom', offset: { dx: 0, dy: 0 } },
      ],
    },

    // Phase 6.2.C2 — Pegasus-class assault carrier. UC canon: the Pegasus
    // family (White Base / Pegasus II / Albion) is the Federation's fast
    // capital-grade carrier-cruiser — heavily armored, MS-hangar-equipped,
    // capable of cracking a destroyer or shielding a strike fleet. The
    // Von Braun AE drydock sells a refurbished hull through the surface
    // sales rep; player parks it in the Von Braun state drydock's `capital`
    // slot. Aspirational mid-game content — substantially pricier than the
    // lightFreighter / lunarMilitia (multi-million ¥) so the climb feels
    // earned. Walkable interior is bigger (bridge, captain's office, comm
    // room, war room, crew, mess, engine, medbay, hangar bay, brig) so
    // 6.2.5+ retrofit/officer wall content has authored rooms to surface
    // in without re-authoring the template. The hangar bay declares a
    // higher MS capacity via the future MS-aboard mechanic at 6.2.5; the
    // field can live on the schema today (ShipStatSheet at 6.2.B added
    // hangarCapacity already, no consumer yet).
    {
      id: 'pegasusClass',
      nameZh: '飞马级强袭母舰',
      descZh: '联邦"飞马"系列改装舰 · 强装甲快速航母 · 内置 MS 机库与重型武装 · 在 AE 冯·布劳恩轨道船坞二次出售给民间。',
      shipClass: 'capital',
      hangarSlotClass: 'capital',
      hullMax: 6000,
      armorMax: 1800,
      fluxMax: 9000,
      fluxDissipation: 360,
      hasShield: false,
      shieldEfficiency: 1.0,
      topSpeed: 50,
      accel: 30,
      decel: 18,
      angularAccel: 1.2,
      maxAngVel: 0.8,
      crMax: 100,
      fuelMax: 80,
      suppliesMax: 400,
      supplyPerDay: 18,
      // Issue #69 — capital carrier; the single most expensive hull to
      // commit to an engagement (a 20-ship fleet fields a small subset).
      dpCost: 10,
      crewMax: 200,
      brigCapacity: 8,
      // Phase 6.2.5 — internal MS bay. Pegasus-class hangar bay holds up
      // to 4 MS internally; aligns with UC canon White Base complement.
      hangarCapacity: 4,
      // W4.3 — forward-repair band. A carrier's full deck patches to 80% and
      // holds the baseline 40% floor; a dedicated tender would lower the floor
      // further to salvage deeper-damaged units in the field.
      onShipRepairCap: 0.8,
      onShipRepairFloor: 0.4,
      // Phase 6.2.5.C — White-Base-shape door authoring. UC canon: the
      // Pegasus opens its bow doors and catapults MS forward. Three
      // doors against four bays produces the carrier-vs-frigate asymmetry
      // from Design/sortie.md: three MS cycle simultaneously, the fourth
      // queues. Positions are hull-local arena units; facing is the
      // launch direction in degrees relative to the ship's heading.
      hangarDoors: [
        { id: 'bow-port', position: { x:  6, y:  24 }, facing:    0, bayId: 'bay-1' },
        { id: 'bow-stbd', position: { x: -6, y:  24 }, facing:    0, bayId: 'bay-2' },
        { id: 'aft-port', position: { x:  6, y: -28 }, facing:  180, bayId: 'bay-3' },
      ],
      officers: {
        adjutant: { name: '布莱特·诺亚', title: '副官' },
      },
      mounts: [
        { idx: 0, size: 'large',  firingArcDeg: 45,  facingDeg: 0    },
        { idx: 1, size: 'medium', firingArcDeg: 90,  facingDeg: 90   },
        { idx: 2, size: 'medium', firingArcDeg: 90,  facingDeg: -90  },
        { idx: 3, size: 'medium', firingArcDeg: 60,  facingDeg: 0    },
        { idx: 4, size: 'small',  firingArcDeg: 180, facingDeg: 180  },
        { idx: 5, size: 'small',  firingArcDeg: 180, facingDeg: 180  },
      ],
      // Issue #165 — every mount armed. All catalog weapons are 'small'
      // size (fits any mount rank); the broadside pair carries ballistics
      // for armor cracking, the rest beams for flux pressure + rear cover.
      defaultWeapons: ['beamMk1', 'ballisticMk1', 'ballisticMk1', 'beamMk1', 'beamMk1', 'beamMk1'],
      ai: {
        aggression: 0.4,
        retreatThresholdPct: 0.15,
        maintainRange: 320,
      },
      priceFiat: 1200000,
      rooms: [
        {
          id: 'bridge', nameZh: '舰桥', bounds: { x: 0, y: 0, w: 3, h: 2 },
          interactables: [
            { kind: 'helm', label: '操舵 / 航行', offset: { dx: 0, dy: -0.5 } },
          ],
        },
        {
          id: 'captainsOffice', nameZh: '船长室', bounds: { x: 3, y: 0, w: 3, h: 2 },
          interactables: [
            { kind: 'captainsDesk', label: '出航简报', offset: { dx: -0.5, dy: -0.5 } },
            { kind: 'commPanel',    label: '通讯面板', offset: { dx: 0.5,  dy: -0.5 } },
          ],
        },
        { id: 'commRoom',  nameZh: '通讯室', bounds: { x: 6, y: 0, w: 2, h: 2 } },
        {
          // Phase 6.2.E1 — pegasusClass has a dedicated 作战室 room. The
          // war-room plot table sits inside it (lightFreighter mounts
          // the same kiosk on the bridge, see above). Centered offset
          // so the table reads as the room's purpose at-a-glance.
          id: 'warRoom',   nameZh: '作战室', bounds: { x: 0, y: 2, w: 3, h: 2 },
          interactables: [
            { kind: 'warRoom', label: '战略图台', offset: { dx: 0, dy: 0 } },
          ],
        },
        {
          // W4.2 — furnished carrier quarters. Captain's bunk + five crew
          // racks fill the 3×2 room (offsets = the six tile centres). A
          // 200-hand complement is aspirational; extra crew wrap / bunk-hot.
          id: 'crewQ',     nameZh: '船员舱', bounds: { x: 3, y: 2, w: 3, h: 2 },
          interactables: [
            { kind: 'sleep', label: '舰长铺位', offset: { dx: -1, dy: -0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: 0,  dy: -0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: 1,  dy: -0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: -1, dy: 0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: 0,  dy: 0.5 } },
            { kind: 'sleep', label: '船员铺位', offset: { dx: 1,  dy: 0.5 } },
          ],
        },
        {
          // W4.2 — carrier mess. Eat station the player + crew share; crew
          // draw the shared ship supply pool per meal (config).
          id: 'mess',      nameZh: '餐厅',   bounds: { x: 6, y: 2, w: 2, h: 2 },
          interactables: [
            { kind: 'eat', label: '餐台', offset: { dx: -0.5, dy: -0.5 } },
          ],
        },
        { id: 'engineRoom', nameZh: '引擎室', bounds: { x: 0, y: 4, w: 3, h: 2 } },
        { id: 'medbay',    nameZh: '医务室', bounds: { x: 3, y: 4, w: 2, h: 2 } },
        {
          id: 'brig', nameZh: '禁闭室', bounds: { x: 5, y: 4, w: 3, h: 2 },
          interactables: [
            { kind: 'brig', label: '查看囚犯', offset: { dx: 0, dy: -0.5 } },
          ],
        },
        {
          id: 'hangarBay', nameZh: '机库', bounds: { x: 0, y: 6, w: 8, h: 2 },
          interactables: [
            { kind: 'disembarkShip', label: '下船', offset: { dx: -2, dy: -0.5 } },
            // Phase 6.2.5.A — climbIntoMs kiosk removed; the MS sprite
            // entity is the climb-in walk-up (spawned by refreshMsLayout).
          ],
        },
      ],
      doors: [
