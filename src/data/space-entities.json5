// Hand-placed persistent enemies in the Earth Sphere campaign sector.
//
// Each entry spawns a real koota entity at game start; entities persist
// state (hull, position, ai mode) across encounters. There are NO RNG
// encounter rolls — every threat the player meets is one of these
// entities, visible on the map at all times.
//
// shipClassId references src/data/enemyShips.json5; it's the lead ship
// of the fleet. `escorts` is an optional list of additional ship class
// IDs that appear alongside the lead in the tactical engagement —
// combat resolves 1 vs (1 + escorts.length).
//
// Coordinates are absolute world px in a 30000 × 24000 sector. The shoal
// zone sits between Sides 5/6 around the lunar shell (y≈12000); the
// outer belt sits past 16000 from Earth.
{
  entities: [
    // Shoal-zone pirate skirmishers — patrol loops between Sides 5/6 area.
    // Each patrol cell rolls with one wingman, so a Von Braun graduate
    // hits 1v2 from the very first run.
    {
      id: 'pirate-shoal-1',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      // W3 (ms-identity) Task 2 — first authored hostile-MS wingman. Light
      // junker brawler; the shoal zone is early/mid-game content so a
      // gm_pre-piloted player meets its first hostile MS here, not at the
      // (deliberately solo) Von Braun starter picket.
      msComplement: ['pirate_junkerMs'],
      spawn: { x: 9500, y: 11200 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 9500, y: 11200 },
        { x: 10500, y: 12400 },
        { x: 9200, y: 12800 },
        { x: 8800, y: 11800 },
      ],
      // W1 Task 7 — 5x the pre-tuning radius so a patrol notices the
      // player's course from well outside weapons range, not only once
      // the ship is nearly on top of it.
      aggroRadius: 3000,
      fleeHullPct: 0.25,
    },
    {
      id: 'pirate-shoal-2',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      // W3 (ms-identity) Task 2 — fire-support MS wingman variant.
      msComplement: ['pirate_junkerMs_gun'],
      spawn: { x: 11800, y: 12600 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 11800, y: 12600 },
        { x: 12600, y: 13400 },
        { x: 11200, y: 13200 },
      ],
      aggroRadius: 3000,
      fleeHullPct: 0.25,
    },
    {
      id: 'pirate-shoal-3',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      spawn: { x: 10200, y: 13800 },
      aiMode: 'idle',
      aggroRadius: 2500,
      fleeHullPct: 0.2,
    },
    {
      id: 'pirate-shoal-4',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      spawn: { x: 8400, y: 13200 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 8400, y: 13200 },
        { x: 7800, y: 12400 },
        { x: 8200, y: 11600 },
      ],
      aggroRadius: 3000,
      fleeHullPct: 0.25,
    },

    // Near-moon orbit pirates — patrol the lunar shell east of Earth. At game
    // start the Moon sits at (19000, 12000); these ships linger within ~2000 px
    // of that position so the player encounters them on the first departure
    // from Von Braun. pirate_skirmisher entries are weaker patrol craft;
    // pirate_raider is the fleet anchor.
    //
    // Only pirate-lunar-starter sets anchorBodyId:'moon' (see space-entities.ts):
    // its coords are authored absolute at t=0 but track the moon's live position,
    // so the home picket orbits WITH the dock and is still on the Von Braun
    // approach after a multi-day delivery wait carries the moon ~90deg away. The
    // heavier lunar groups stay fixed-coord — deliberate mid-game content the
    // player flies OUT to; anchoring them too would crowd the freshly-won home
    // fight with a second contact the starter freighter can't survive.
    //
    // W1 Task 10 — the earned-start LOOP needs a FIRST fight a stock
    // lightFreighter can actually win, near enough to Von Braun to complete
    // undock → intercept → fight → return inside the 60-fuel tank. That role
    // is pirate-lunar-starter below: a SINGLE weak pirateLight (no escorts,
    // 1-v-1, empirically winnable at ~70% hull), patrolling within ~1200 px of
    // the Von Braun orbit. It is the sole authored group covering every
    // near-moon dock anchor (vonBraun / vonBraunDrydock / marikoRefinery) at
    // t=0, and it inherits the "genuinely pursues from far" role — its aggro
    // is the spec's 1/8-sector-width (3750 = 30000/8), so an undock anywhere
    // near the moon is noticed and chased down to contact.
    //
    // Every OTHER near-moon group is staggered so its circle EXCLUDES all three
    // dock anchors with a >=20% distance margin (orbits move, so a hairline
    // miss today becomes a hit tomorrow). This keeps the home-port undock a
    // single-pirate encounter, never a multi-group ambush — see
    // space-entities.test.ts. pirate-lunar-3 (south-east) and Char Aznable's
    // raider (pirate-lunar-4, north-east) are pushed clear of the Von Braun ↔
    // starter approach corridor as well, so the starter is the reliable first
    // contact and Char's heavier 1-v-3 is deliberate mid-game content the
    // player must fly out to.
    {
      // W1 Task 10 — the winnable starter encounter. One weak pirateLight,
      // no escorts, station-keeping just off the Von Braun approach.
      id: 'pirate-lunar-starter',
      kind: 'enemyShip',
      shipClassId: 'pirateLight',
      // Closer to Von Braun than any other pirate (680px vs lunar-1's 732px),
      // so "nearest authored enemy" resolvers (fuel-budget / intercept smokes)
      // target this big-aggro, reliably-chasing picket rather than a small-aggro
      // patrol they can't cleanly close on.
      spawn: { x: 19180, y: 12680 },
      // anchorBodyId below rigidly pins position every tick (enemyAISystem's
      // anchor branch returns before the patrol-walk logic runs), so this
      // entity never actually patrols — 'idle' names that truthfully; no
      // patrolPath is authored since it would be dead data.
      aiMode: 'idle',
      // 1/8-sector-width reach (30000 / 8), transferred here from
      // pirate-lunar-4: the sole near-moon patrol that "genuinely pursues"
      // an undocking ship, so the earned-start intercept reliably converges.
      aggroRadius: 3750,
      fleeHullPct: 0.2,
      // Follow the moon so it stays on the Von Braun approach at all times —
      // the dock orbits ~90deg away over a multi-day delivery wait, and a
      // fixed-coord patrol would be orphaned far from where the player undocks.
      anchorBodyId: 'moon',
    },
    {
      id: 'pirate-lunar-1',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      spawn: { x: 19600, y: 11400 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 19600, y: 11400 },
        { x: 20400, y: 12000 },
        { x: 19800, y: 13000 },
        { x: 18800, y: 12200 },
      ],
      aggroRadius: 500,
      fleeHullPct: 0.20,
    },
    {
      id: 'pirate-lunar-2',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      spawn: { x: 18400, y: 10800 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 18400, y: 10800 },
        { x: 19200, y: 11200 },
        { x: 18600, y: 11800 },
        { x: 17800, y: 11200 },
      ],
      aggroRadius: 950,
      fleeHullPct: 0.20,
    },
    {
      // W1 Task 10 — pushed south-east so it clears the Von Braun dock anchors
      // at t=0 with margin (invariant); fixed-coord mid-game content the player
      // flies out to (only the starter follows the moon toward home).
      id: 'pirate-lunar-3',
      kind: 'enemyShip',
      shipClassId: 'pirate_skirmisher',
      escorts: ['pirate_skirmisher'],
      spawn: { x: 21400, y: 14200 },
      aiMode: 'idle',
      aggroRadius: 900,
      fleeHullPct: 0.20,
    },
    // Lunar raider with two skirmisher wingmen — heaviest near-moon
    // engagement, 1v3. Lead is captained by Char Aznable in disguise
    // (Phase 6.2 notable hostile); the player only knows him by the
    // "Red Comet" rumor until they fight him and either kill or
    // capture. Per Design/post-combat.md, capture happens when his
    // ship is destroyed and the brig has capacity.
    {
      id: 'pirate-lunar-4',
      kind: 'enemyShip',
      shipClassId: 'pirate_raider',
      escorts: ['pirate_skirmisher', 'pirate_skirmisher'],
      notableCaptains: { '0': 'char-aznable-0077-disguise' },
      // W1 Task 10 — relocated north-east, well clear of the Von Braun home
      // approach, so a first undock never stumbles into this 1-v-3. Char's
      // raider is now deliberate mid-game content the player must fly out to.
      spawn: { x: 22500, y: 10500 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 22500, y: 10500 },
        { x: 23500, y: 10800 },
        { x: 23200, y: 9600 },
        { x: 22000, y: 10000 },
      ],
      // Mid-game "genuinely pursues" reach out in its own corner — sized well
      // below its distance to every near-moon dock anchor (nearest ~2930px to
      // Von Braun) with a wide margin, so it never covers the home-port turf.
      aggroRadius: 2000,
      fleeHullPct: 0.15,
    },

    // Outer-belt raiders — heavier, near Axis/Pezun radii. Anavel
    // Gato leads the easterly flotilla; Ramba Ral the westerly one.
    {
      id: 'pirate-outer-1',
      kind: 'enemyShip',
      shipClassId: 'pirate_raider',
      escorts: ['pirate_skirmisher'],
      notableCaptains: { '0': 'gato-0077-corp-raider' },
      // W3 (ms-identity) Task 2 — Gato's flotilla is the heaviest authored
      // outer-belt group; it fields both junker MS variants alongside its
      // ships, deliberate mid/late-game escalation over the shoal-zone
      // groups above.
      msComplement: ['pirate_junkerMs', 'pirate_junkerMs_gun'],
      spawn: { x: 27000, y: 8400 },
      aiMode: 'patrol',
      patrolPath: [
        { x: 27000, y: 8400 },
        { x: 28000, y: 9200 },
        { x: 26200, y: 9600 },
      ],
      aggroRadius: 4000,
      fleeHullPct: 0.15,
    },
    {
      id: 'pirate-outer-2',
      kind: 'enemyShip',
      shipClassId: 'pirate_raider',
      escorts: ['pirate_skirmisher'],
      notableCaptains: { '0': 'ramba-ral-0077-corp-raider' },
      spawn: { x: 4200, y: 18800 },
      aiMode: 'idle',
      aggroRadius: 4000,
      fleeHullPct: 0.15,
    },
  ],
}
