// Phase 6.2.A — hangar facility class shapes. Per Design/fleet.md and
// Design/social/facilities-and-ownership.md, hangars come in two tiers,
// both authored from the same template. The tier governs which slot
// classes are housed (surface = MS / fighter / MW; drydock = capital).
//
// Each row is keyed by a building-type id (in building-types.json5) and
// carries the *facility-class* shape — capacities, storage caps, daily
// economics that don't fit cleanly on BuildingType. Only one tier
// (`hangarSurface`) is actually placed at Phase 6.2.A; the drydock row
// is authored here so the schema locks in for 6.2.A.2 / 6.2.C2 without
// a follow-up data churn.
//
// Slot classes (largest → smallest):
//   capital     — cruiser / battleship slip. Drydock tier only.
//   ms          — mobile-suit-sized bay (20m frames). Surface tier only.
//   smallCraft  — fighters / mobile workers / shuttles. Both tiers.
//
// Hierarchy: a slot of a given class can house ships of its class OR any
// smaller class (capital ⊇ ms ⊇ smallCraft). Smaller ships in a larger
// slot are physically wasteful but supported — the player decides when to
// burn capacity for convenience. Hierarchy is encoded in
// `data/facilityTypes.ts:HANGAR_SLOT_HIERARCHY`.
//
// Capacity-only verbs ship at 6.2.A; ShipStatSheet + persistent damage +
// repair throughput land at 6.2.B; supply/fuel storage drain + dealer
// orders at 6.2.F; transfer-to-other-hangar (paid + delayed) at 6.2.G or
// E2 (whichever defines the shipment-day infra first). Authoring those
// numerics here ahead of consumers would be speculative — keep this
// minimal, grow with each slice that needs more.
//
// Phase 6.2.F — per-tier supplyStorage / fuelStorage caps. Tuned so the
// 6.2.F demo (single lightFreighter draining 4 supply/day off a fully-
// stocked surface hangar with 1000 cap) reads "single-digit days to
// empty" — the AE dealer's 2-day delivery window then visibly refills.
// Drydock tier capacities are ~5× surface because capital tonnage burns
// more supply than civilian hulls (authoring locked here so 6.2.C2's
// Pegasus row doesn't churn this file).

{
  // Hangar-slot class hierarchy, listed largest-first. A slot of class C
  // accepts ships whose class sits at or below C in this list. Adding a
  // new class (e.g. 'frigate' between capital and ms) is one edit here
  // plus a row in HangarSlotClass type. Order matters; consumers walk it
  // linearly from a ship's own class upward to find a fitting slot.
  slotHierarchy: ['capital', 'ms', 'smallCraft'],

  hangars: {
    hangarSurface: {
      tier: 'surface',
      slotCapacity: { ms: 4, smallCraft: 4 },
      supplyStorage: 1000,
      fuelStorage: 400,
    },
    hangarDrydock: {
      tier: 'drydock',
      slotCapacity: { capital: 4, smallCraft: 12 },
      supplyStorage: 5000,
      fuelStorage: 2000,
    },
    // Phase 6.3.B — colony supply depot. Smaller than the VB state hangar;
    // holds MS-tier ships + light small-craft. Supply/fuel caps are scaled
    // down to match a small independent colony's logistics footprint.
    // Stocked and topped up daily by colonyEconomicsSystem.
    colonyHangar: {
      tier: 'surface',
      slotCapacity: { ms: 2, smallCraft: 2 },
      supplyStorage: 500,
      fuelStorage: 200,
    },
  },

  // ── Phase 5.5.6 — facility tiers (Design/social/facility-tiers.md) ──────
  // Per-class tier ladders for the four universal knobs. Keyed by
  // building-type id. Tier 1 is always the existing baseline (layout seats,
  // mul 1.0, per-job-spec hours) so a facility with no FacilityTiers trait
  // behaves exactly as before. Tier-N rows (N>1) carry:
  //   requiresUnlock — FactionUnlocks string a research must emit first;
  //                    the row stays visible-but-locked until then.
  //   creditCost     — paid from the owner's fund/wallet at install.
  //   downtimeDays   — whole facility offline (no output, no salary;
  //                    maintenance still applies) until installed.
  //   addStations    — (jobSiteCount only) object-template ids spawned as
  //                    new seats on completion.
  //   mul            — (efficiency / loyaltyDrift) multiplier at this tier.
  // The 5.5.7 authoring pass adds tier-2/3 rows for the other classes and
  // knobs; 5.5.6 ships the factory job-site ladder the research spine's
  // first unlock (upgrade:factory-tier-2) gates.
  tiers: {
    factory: {
      jobSiteCount: [
        { tier: 1 },
        { tier: 2,
          addStations: ['workstation-factory-worker-morning', 'workstation-factory-worker-day'],
          requiresUnlock: 'upgrade:factory-tier-2',
          creditCost: 12000,
          downtimeDays: 3 },
      ],
      efficiency: [
        { tier: 1, mul: 1.0 },
      ],
      operatingHours: [
        { tier: 1 },
      ],
      loyaltyDrift: [
        { tier: 1, mul: 1.0 },
      ],
    },
  },
}
